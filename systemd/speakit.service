[Unit]
Description=speakit voice-to-text daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Point this at the project dir if you move it.
WorkingDirectory=%h/Desktop/web/speakit
# Run the venv entrypoint directly: no uv parent process, no env re-sync
# (and no network) on every start. install.sh runs uv sync.
ExecStart=%h/Desktop/web/speakit/.venv/bin/speakitd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
