[Unit]
Description=ydotoold uinput virtual input daemon (for speakit)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Socket in the per-user runtime dir; speakit points ydotool at the same path.
ExecStart=/usr/bin/ydotoold --socket-path=%t/.ydotool_socket --socket-perm=0600
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
